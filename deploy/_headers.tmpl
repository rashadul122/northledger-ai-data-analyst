# NorthLedger _headers (Workers Static Assets). GENERATED by tools/make_dist.py from this template
# and deploy/cloudflare.config.json; edit the template, never dist/_headers.
# Limits: 100 blocks, 2,000 characters a line. Blocks that set the SAME header are JOINED with a comma,
# so: security headers only in /*; Content-Security-Policy and Cache-Control only in specific blocks.
# Redirects run before headers (a path that redirects gets only the /* block).
# Test each block:  curl -sI https://<host>/<path>   (tools/check_dist.py resolves these rules offline).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Strict-Transport-Security: {{HSTS}}
  X-Frame-Options: DENY
  Permissions-Policy: accelerometer=(), autoplay=(), browsing-topics=(), camera=(), clipboard-read=(), clipboard-write=(self), display-capture=(), fullscreen=(self), geolocation=(), gyroscope=(), hid=(), interest-cohort=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), serial=(), usb=(), xr-spatial-tracking=()

# No COOP/COEP/CORP: Pyodide here needs no SharedArrayBuffer, and COOP could break window.open of a PDF.
# Referrer-Policy no-referrer: the page's cross-origin POSTs are CORS-mode, so Origin is still sent.
# Origins the page contacts: itself, and the AI proxy (/plan /report /share /r/<slug>/delete). Nothing else.

# ---- the page. 'unsafe-inline' stays (three inline scripts, one style, style attributes) until the inline
# ---- script is split into hashed files. The page makes no wasm itself: the engine runs in a Web Worker.
# ---- With auto-trailing-slash, /index.html redirects to / and /name.html to /name, so these are the final paths.
/
  {{CSP_HEADER}}: default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'none'; connect-src {{PAGE_CONNECT}}; worker-src 'self'; manifest-src 'none'; media-src 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
  Cache-Control: public, max-age=300, must-revalidate

# ---- pages with no network access at all
/case-study
  {{CSP_HEADER}}: default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
  Cache-Control: public, max-age=300, must-revalidate

/agent-demo
  {{CSP_HEADER}}: default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
  Cache-Control: public, max-age=300, must-revalidate

# A direct request for the 404 page. Unknown paths are answered with this file's body and a 404, but the
# rule that matches THEM is /*, so the page carries no CSP there: it has no script and no network use.
/404.html
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'

# ---- the engine. A worker script takes the CSP of its OWN response, not the page's. This is the privacy
# ---- enforcement: it may run wasm and fetch from this origin only; it cannot reach the AI proxy or anything else.
# ---- If the Playwright check shows a violation from Pyodide's glue, set headers.unsafe_eval_for_engine_worker
# ---- in deploy/cloudflare.config.json: it adds 'unsafe-eval' HERE ONLY.
/engine/worker.js
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval'{{WORKER_SCRIPT_EXTRA}}; connect-src 'self'{{WORKER_CONNECT_EXTRA}}; base-uri 'none'
  Cache-Control: public, max-age=300, must-revalidate

# ---- the self-hosted runtime: a content-named folder (version + hash of every file), so 'immutable' is safe
{{RUNTIME_BLOCK}}
# The engine zip keeps Cloudflare's default (max-age=0, must-revalidate, with an ETag): the worker already
# fetches it with cache: 'no-cache', and a repacked engine must never be served stale.
/engine/pack.json
  Cache-Control: public, max-age=300, must-revalidate

# sample-messy.csv: Cloudflare's compression list has no text/csv, so it would be sent uncompressed (268,634 B
# instead of about 38,000). text/plain is on the list. (The docs say a _headers Content-Type overrides the
# default; confirm on the preview: curl -sI .../engine/sample-messy.csv.)
/engine/sample-messy.csv
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/engine/world-110m.json
  Cache-Control: public, max-age=86400

# ---- other assets
/data/*
  Cache-Control: public, max-age=300, must-revalidate
/downloads/*
  Cache-Control: public, max-age=3600
/favicon.svg
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'
  Cache-Control: public, max-age=86400
/favicon-32.png
  Cache-Control: public, max-age=86400

# ---- keep the free workers.dev name out of search results once the custom domain is canonical
{{NOINDEX_HOST}}
  X-Robots-Tag: noindex
